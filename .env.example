# Web local development template.
# Copy to .env and replace placeholder secrets before running pnpm dev.

OATHKEEPER_URL=http://localhost:24455
KRATOS_URL=http://localhost:8000
KRATOS_ADMIN_URL=http://localhost:24434
HYDRA_ADMIN_URL=http://localhost:24445
MCP_OAUTH_ISSUER_URL=https://sso.dev.example
SESSION_COOKIE_NAME=site_session_dev
HOST=site.dev.example

# Generate real local values with openssl before using against non-local data.
DRAFT_SECRET=replace-with-at-least-16-characters
ENCRYPTION_SECRET=replace-with-at-least-16-characters

SITE_ORIGIN=https://site.dev.example
PUBLIC_CDN_URL=https://cdn.dev.example
PUBLIC_API_URL=https://api.dev.example
# Device-enabled p5.js previews require a cookie-less HTTPS origin on a
# different registrable domain. Route only /tools/p5-runner and
# /vendors/p5/p5.min.js from that origin to this Web service.
PUBLIC_P5_RUNNER_URL=https://runtime.dev.example/tools/p5-runner
PUBLIC_EDITOR_IMAGE_MAX_SIZE_BYTES=31457280
PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
AUTH_CODE_LIFESPAN_SECONDS=900
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60

# Optional operational settings.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_RESOURCE_ATTRIBUTES=service.namespace=geul,deployment.environment=development
