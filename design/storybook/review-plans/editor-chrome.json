    "components/core/Modal/confirm-dialogs.test.tsx",
    "components/core/ImageCropper/ImageCropper.test.tsx",
    "features/document-layout/ContentLayoutField.test.tsx",
    "features/document-layout/ContentLayoutFieldView.naming.test.tsx",
    "features/translation/TranslationLocaleControl.test.tsx",
    "features/translation/ContentLanguageMenu.test.tsx",
    "features/translation/locale-option-format.test.tsx",
    "features/translation/EntityTranslationsPanel.test.tsx",
    "lib/translation/content-language.test.ts",
    "features/editor/components/EditorFileLibraryPicker.test.tsx",
