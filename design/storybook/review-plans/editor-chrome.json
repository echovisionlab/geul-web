  "toolingTests": ["scripts/design-system"],
  "checks": [
    {
      "name": "core-types",
      "command": [
        "node",
        "node_modules/typescript/bin/tsc",
        "--noEmit",
        "--project",
        "components/core/tsconfig.type-test.json"
      ]
    },
    {
      "name": "input-styles",
      "command": ["node", "node_modules/stylelint/bin/stylelint.mjs", "components/core/Input/Input.module.css"]
    }
  ],
  "build": { "minify": false },
  "storybook": { "url": "http://127.0.0.1:6010" },
  "criticalPaths": [
    "components/core/Input",
    "components/core/Modal",
    "components/core/ImageCropper",
    "features",
    "lib/translation",
    "stories",
    "docs/design-system",
    "docs/design-system.md",
    "components/core/design-tokens.ts",
    "lib/styles/design-tokens.css",
    "scripts/design-system"
  ],
  "manualNotes": "design/storybook/review-notes/editor-chrome.json",
  "screenshots": [
    "design/storybook/previews/editor-chrome/layout-phone-ko.png",
    "design/storybook/previews/editor-chrome/layout-desktop-en.png",
    "design/storybook/previews/editor-chrome/switch-light-ko.png",
    "design/storybook/previews/editor-chrome/switch-dark-en.png",
    "design/storybook/previews/editor-chrome/post-language-ko.png",
    "design/storybook/previews/editor-chrome/file-dialog-ko.png"
  ],
  "priorRuns": [],
  "boundaries": [
    "Production Views use local fixtures; backend persistence and native assistive technology acceptance are outside this review.",
    "Responsive browser checks use a fine pointer. They do not emulate physical touch."
  ]
