  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "scripts": {
    "prepare:maplibre-worker": "node scripts/prepare-maplibre-worker.mjs",
    "prepare:p5-runtime": "node scripts/prepare-p5-runtime.mjs",
    "dev": "dotenv -e .env -- next dev --turbo --port 3000",
    "build": "env -u NODE_ENV dotenv -e .env -- next build",
    "build:local-contracts": "LOCAL_CONTRACTS=1 OATHKEEPER_URL=http://localhost:8000 KRATOS_URL=http://localhost:4433 KRATOS_ADMIN_URL=http://localhost:4434 HYDRA_ADMIN_URL=http://localhost:4445 MCP_OAUTH_ISSUER_URL=http://sso.localhost:4444 SITE_ORIGIN=http://localhost:3000 SESSION_COOKIE_NAME=site_session DRAFT_SECRET=build-time-placeholder-secret123 ENCRYPTION_SECRET=build-time-placeholder-secret123 HOST=localhost pnpm build",
    "typecheck": "tsc --noEmit",
    "typecheck:local-contracts": "tsc --noEmit --project tsconfig.local-contracts.json",
    "lint": "eslint --cache . --max-warnings=0",
    "lint:styles": "stylelint '**/*.css' --cache",
    "format": "prettier --write .",
    "test": "vitest run --fileParallelism",
    "test:local-contracts": "vitest run --config vitest.local-contracts.config.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:local-contracts": "LOCAL_CONTRACTS=1 storybook dev -p 6006",
    "storybook:build:local-contracts": "LOCAL_CONTRACTS=1 storybook build",
    "i18n:sync-weblate": "python3 scripts/i18n/sync-weblate-messages.py",
    "prepare:client-media-codecs": "node scripts/prepare-client-media-codecs.mjs",
    "postinstall": "pnpm prepare:client-media-codecs"
  },
