{
  "compilerOptions": {
    "types": ["node", "vitest/globals", "google.maps"],
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "strict": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "react/jsx-runtime.js": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "monaco-editor/esm/vs/editor/editor.api": ["./node_modules/monaco-editor/esm/vs/editor/editor.api.d.ts"],
      "typescript": ["./node_modules/@typescript/tooling"],
      "@/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".storybook/main.ts",
    ".storybook/preview.tsx",
    ".storybook/test-runner.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-integration/types/**/*.ts",
    ".next-integration/dev/types/**/*.ts",
    ".next-integration-*/types/**/*.ts",
    ".next-integration-*/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "**/*.story.ts",
    "**/*.story.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx"
  ]
}
